# Переменные для docker compose. Файл .env НЕ обязателен: у всех значений есть
# значения по умолчанию в docker-compose.yml. Скопируйте в .env, только если хотите их поменять.
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa
POSTGRES_DB=credit
JWT_SECRET=change-me-in-real-env
# Пауза между этапами конвейера в миллисекундах — чтобы на демо было видно смену статусов
PIPELINE_STEP_MS=1500
